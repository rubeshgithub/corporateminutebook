# MinuteBook API — environment template.
# Copy to `.env` and fill in. Never commit the filled-in file.
# The server validates this on boot (see src/config/env.ts): the REQUIRED
# block below aborts startup if missing; the rest only disable features.

# ─── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/minutebook
# Must be >= 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# ─── Core ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origin of the SPA. Drives BOTH the CORS allowlist and the CSRF origin check,
# so it must exactly match the URL the browser loads (scheme + host + port).
FRONTEND_URL=http://localhost:5173
# This backend's own public origin. Backs the unsubscribe links embedded in
# reminder emails (they must resolve from a mail client, no session). Set to
# the Render backend URL in production.
BACKEND_PUBLIC_URL=http://localhost:5000

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
# Optional but strongly recommended in production — without it, server errors
# exist only in stdout logs. Create a Node project at sentry.io and paste its DSN.
SENTRY_DSN=

# ─── Incorporation-PDF parsing (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── AWS: SES email + S3 attachment storage ──────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified SES sender. Use a dedicated sending domain with SPF/DKIM/DMARC.
SES_FROM=MinuteBook <noreply@yourdomain.ca>
# REQUIRED in production (boot fails without it): without a bucket, uploads
# fall back to local disk — ephemeral on Render, so signed resolutions would
# be silently destroyed on the next deploy. Dev may leave it blank.
S3_ATTACHMENTS_BUCKET=
S3_ATTACHMENTS_PREFIX=attachments/
# Region of the attachments bucket, when it differs from AWS_REGION (e.g.
# bucket in ca-central-1 for Canadian data residency, SES in us-east-1).
# Falls back to AWS_REGION when unset.
S3_REGION=ca-central-1

# ─── E-signature (DocuSeal) ──────────────────────────────────────────────────
DOCUSEAL_API_KEY=
DOCUSEAL_USER_EMAIL=

# ─── CRS order webhook ───────────────────────────────────────────────────────
# Shared secret for the HMAC-SHA256 signature on POST /api/crs-feed/order-completed.
# Must match the value configured on the CRS side.
CRS_FEED_SECRET=

# ─── Background jobs ─────────────────────────────────────────────────────────
# Both are in-process cron. Enable on exactly ONE instance — a second instance
# double-sends reminder emails.
NOTIFICATIONS_ENABLED=false
DRIFT_CHECK_ENABLED=false

# ─── Persona test suite ──────────────────────────────────────────────────────
# Enables POST /api/auth/test-mint-session (session bypass for Playwright).
# MUST stay false/unset in production.
TEST_MODE_ENABLED=false
TEST_MODE_TOKEN=
