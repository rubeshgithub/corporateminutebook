<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Share Subscriptions - <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 0; line-height: 1.7; font-size: 12pt; color: #1a1a1a; }
        .subscription { page-break-after: always; padding: 60px 50px; }
        .subscription:last-child { page-break-after: auto; }
        h1 { text-align: center; font-size: 16pt; text-decoration: underline; margin-bottom: 30px; }
        .to-line { margin-bottom: 8px; }
        .body { margin-top: 24px; text-align: justify; }
        .signature-block { margin-top: 70px; }
        .sig-line { border-top: 1px solid #000; width: 320px; margin-top: 50px; padding-top: 4px; font-size: 11pt; }
        .holder-detail { font-size: 10.5pt; color: #555; margin-top: 4px; }
    </style>
</head>

<body>
    <%
        var classByName = {};
        (company.shareClasses || []).forEach(function(sc){ classByName[sc.name] = sc; });
        var lookupPar = function(className) {
            var sc = classByName[className];
            return sc && sc.parValue != null ? sc.parValue : null;
        };
        var fmtDate = function(d) {
            return d ? new Date(d).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '_________________';
        };
    %>
    <% (company.shareholders || []).forEach(function(s) { %>
        <%
            var par = lookupPar(s.sharesClass);
            var total = s.considerationPaid != null
                ? Number(s.considerationPaid).toFixed(2)
                : (par != null ? (par * (s.numberOfShares || 0)).toFixed(2) : null);
            var issueDate = fmtDate(s.issuanceDate || company.incorporationDate);
            var certNo = s.certificateNumber || '';
        %>
        <div class="subscription">
            <h1>SHARE SUBSCRIPTION</h1>
            <% if (certNo) { %><p style="text-align:right; font-size:10.5pt; color:#555;">Certificate No. A<%= certNo %></p><% } %>

            <div class="to-line"><strong>TO:</strong> <%= company.name %> (the "Corporation")</div>
            <div class="to-line"><strong>TO:</strong> THE DIRECTORS OF <%= company.name.toUpperCase() %></div>

            <div class="body">
                <% if (total != null) { %>
                <p>The undersigned subscribes for and agrees to take <strong><%= s.numberOfShares %></strong> <strong><%= s.sharesClass %></strong> of the capital of the Corporation and tenders herewith the sum of <strong>$<%= total %></strong> in full payment of the subscription price for these shares.</p>
                <% } else { %>
                <p>The undersigned subscribes for and agrees to take <strong><%= s.numberOfShares %></strong> <strong><%= s.sharesClass %></strong> of the capital of the Corporation and tenders full payment of the subscription price for these shares.</p>
                <% } %>

                <p>The undersigned hereby requests that the said shares be allotted to the undersigned, that the shares be issued as fully paid and non-assessable, and that a certificate for the shares be issued to the undersigned.</p>

                <p style="margin-top: 24px;">DATED effective <%= issueDate %>.</p>
            </div>

            <div class="signature-block">
                <div class="sig-line"><%= s.name %></div>
                <% if (s.holderType === 'Legal Entity') { %>
                    <% if (s.corporateAccessNumber) { %><div class="holder-detail">Corporate Access Number: <%= s.corporateAccessNumber %></div><% } %>
                    <% if (s.businessNumber) { %><div class="holder-detail">Business Number: <%= s.businessNumber %></div><% } %>
                <% } %>
                <% var sFullAddr = [s.address, s.city, s.province, s.postalCode, s.country].filter(Boolean).join(', '); %>
                <% if (sFullAddr) { %><div class="holder-detail"><%= sFullAddr %></div><% } %>
            </div>
        </div>
    <% }); %>
    <% if (!company.shareholders || company.shareholders.length === 0) { %>
        <div class="subscription">
            <h1>SHARE SUBSCRIPTION</h1>
            <p style="text-align: center; font-style: italic;">No shareholders recorded.</p>
        </div>
    <% } %>
</body>

</html>
