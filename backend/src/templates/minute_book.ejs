<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Minute Book - <%= company.name %></title>
    <style>
        @page { size: Letter; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #1a1a1a;
            font-size: 11.5pt;
            line-height: 1.55;
        }

        /* ============ COVER ============ */
        .cover {
            page-break-after: always;
            position: relative;
            height: 9in;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
            background: linear-gradient(135deg, #0d1b3d 0%, #1a237e 55%, #283593 100%);
            box-sizing: border-box;
            padding: 0.7in 0.7in 0.6in 0.7in;
        }
        .cover::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 20% 10%, rgba(255,255,255,0.10), transparent 35%),
                radial-gradient(circle at 80% 95%, rgba(255,255,255,0.08), transparent 40%);
            pointer-events: none;
        }
        .cover-top {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            font-size: 10pt;
            letter-spacing: 4px;
            text-transform: uppercase;
            opacity: 0.85;
        }
        .cover-mid {
            position: relative;
            text-align: center;
        }
        .cover-mid .label {
            font-size: 14pt;
            letter-spacing: 8px;
            opacity: 0.85;
        }
        .cover-mid .corp {
            font-size: 36pt;
            font-weight: 700;
            letter-spacing: 1px;
            margin-top: 14px;
            line-height: 1.15;
        }
        .cover-mid .rule {
            width: 120px;
            height: 3px;
            background: #fff;
            margin: 22px auto 22px auto;
            opacity: 0.85;
        }
        .cover-mid .subtitle {
            font-size: 16pt;
            font-weight: 300;
            letter-spacing: 6px;
            text-transform: uppercase;
        }
        .cover-bottom {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            font-size: 10.5pt;
        }
        .cover-bottom .left, .cover-bottom .right {
            line-height: 1.6;
        }
        .cover-bottom .label-line {
            font-size: 8.5pt;
            letter-spacing: 3px;
            text-transform: uppercase;
            opacity: 0.7;
            margin-bottom: 4px;
        }

        /* ============ COMMON SECTION ============ */
        .page {
            page-break-before: always;
            padding: 0;
        }
        .section-title {
            text-align: center;
            margin: 100px 0 40px 0;
        }
        .section-title .num {
            font-size: 14pt;
            letter-spacing: 8px;
            color: #1a237e;
            text-transform: uppercase;
        }
        .section-title .name {
            font-size: 30pt;
            font-weight: 700;
            margin-top: 14px;
            color: #0d1b3d;
        }
        .section-title .rule {
            width: 80px;
            height: 3px;
            background: #1a237e;
            margin: 22px auto 0 auto;
        }
        .doc-content { padding: 0 0.1in; }
        .doc-content h1 { text-align: center; font-size: 18pt; text-decoration: underline; margin-bottom: 6px; }
        .doc-content h2 { text-align: center; font-size: 13pt; margin-top: 6px; }

        /* shared text styles */
        .preamble { text-align: center; font-style: italic; margin-bottom: 18px; }
        .article-title { font-weight: bold; margin-top: 22px; margin-bottom: 8px; font-size: 12.5pt; text-transform: uppercase; }
        .clause { margin-bottom: 10px; text-align: justify; padding-left: 14px; text-indent: -14px; }
        .clause-no { font-weight: bold; margin-right: 6px; }
        .section-block { margin-top: 22px; }
        .section-block-title { font-weight: bold; text-transform: uppercase; margin-bottom: 8px; font-size: 11.5pt; }
        .signature { margin-top: 50px; }
        .sig-line { border-top: 1px solid #000; width: 280px; margin-top: 40px; padding-top: 4px; }
        table { border-collapse: collapse; width: 100%; margin-top: 8px; }
        th, td { border: 1px solid #555; padding: 6px 8px; text-align: left; font-size: 10.5pt; vertical-align: top; }
        th { background: #f3f3f3; font-weight: bold; }

        /* TOC */
        .toc-list {
            list-style: none;
            padding: 0;
            margin-top: 30px;
            font-size: 12pt;
        }
        .toc-list li {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px dotted #999;
            padding: 8px 0;
        }
        .toc-list li .num { color: #1a237e; font-weight: bold; margin-right: 12px; }
        .toc-list li .label { flex: 1; }

        /* Share certificate (landscape isn't available mid-doc; render portrait variant) */
        .cert-page {
            page-break-before: always;
            padding: 30px;
        }
        .cert-frame {
            box-sizing: border-box;
            border: 8px double #1a237e;
            padding: 36px 44px;
            position: relative;
            min-height: 8in;
            display: flex;
            flex-direction: column;
        }
        .cert-no { text-align: right; font-size: 11px; color: #555; }
        .cert-header { text-align: center; margin-top: 20px; }
        .cert-header .corp-name { font-size: 26px; font-weight: bold; letter-spacing: 2px; color: #1a237e; }
        .cert-header .cert-title { font-size: 18px; margin-top: 6px; letter-spacing: 4px; }
        .cert-header .jurisdiction { font-size: 11px; margin-top: 6px; color: #555; }
        .cert-body { margin-top: 30px; font-size: 14px; line-height: 1.7; text-align: center; flex: 1; }
        .cert-body .holder { font-size: 22px; font-weight: bold; margin: 14px 0; text-decoration: underline; }
        .cert-body .shares-amount { font-size: 30px; font-weight: bold; color: #1a237e; display: block; margin-top: 12px; }
        .cert-body .shares-class { font-size: 15px; margin-top: 4px; }
        .cert-body .legalese { margin-top: 20px; font-size: 12.5px; color: #333; max-width: 78%; margin-left: auto; margin-right: auto; }
        .cert-footer { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 20px; }
        .cert-footer .sig-block { width: 35%; text-align: center; }
        .cert-footer .sig-line { border-top: 1px solid #000; padding-top: 4px; margin-top: 30px; font-size: 12px; }

        /* registers */
        .register-title { font-size: 15pt; font-weight: bold; margin-top: 24px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 2px solid #1a237e; color: #1a237e; }
        .register-subtitle { font-style: italic; color: #555; margin-bottom: 12px; font-size: 10pt; }
        .empty { text-align: center; font-style: italic; color: #888; padding: 18px; }

        /* By-law index + dual signature */
        .bylaw-index { page-break-after: always; }
        .bylaw-index-title { text-align: center; font-size: 18pt; font-weight: bold; margin: 12px 0 24px 0; text-decoration: underline; }
        .bylaw-index-section { font-weight: bold; margin-top: 14px; font-size: 11.5pt; }
        .bylaw-index-item { padding-left: 18px; font-size: 10.5pt; color: #333; }
        .sig-block-title { font-weight: bold; margin-top: 22px; margin-bottom: 6px; font-size: 11.5pt; }
        .sig-grid { display: flex; flex-wrap: wrap; gap: 24px; }
        .sig-cell { width: 280px; }

        /* Glossary */
        .glossary-title { text-align: center; font-size: 26pt; font-weight: 700; margin: 80px 0 30px 0; letter-spacing: 2px; }
        .glossary-list { padding-left: 24px; font-size: 12pt; line-height: 1.65; }
        .glossary-list li { margin-bottom: 14px; padding-left: 6px; text-align: justify; }
        .glossary-list .term { font-weight: bold; }
    </style>
</head>

<body>
    <% var today = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }); %>
    <% var incorpDate = company.incorporationDate ? new Date(company.incorporationDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : '—'; %>

    <!-- ============ COVER ============ -->
    <div class="cover">
        <div class="cover-top">
            <span>MinuteBook</span>
            <span><%= today %></span>
        </div>
        <div class="cover-mid">
            <div class="label">Corporate</div>
            <div class="corp"><%= company.name %></div>
            <div class="rule"></div>
            <div class="subtitle">Minute Book</div>
        </div>
        <div class="cover-bottom">
            <div class="left">
                <div class="label-line">Registered Office</div>
                <div><%= company.registeredOfficeAddress.street %></div>
                <div><%= company.registeredOfficeAddress.city %>, <%= company.registeredOfficeAddress.province %> <%= company.registeredOfficeAddress.postalCode %></div>
                <div><%= company.registeredOfficeAddress.country %></div>
            </div>
            <div class="right" style="text-align: right;">
                <div class="label-line">Incorporated</div>
                <div><%= incorpDate %></div>
                <% if (company.corporateAccessNumber) { %>
                    <div class="label-line" style="margin-top: 10px;">Access No.</div>
                    <div><%= company.corporateAccessNumber %></div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ============ GLOSSARY ============ -->
    <div class="page">
        <div class="glossary-title">GLOSSARY</div>
        <ol class="glossary-list">
            <li><span class="term">Articles of Incorporation:</span> Legal documents filed with the government when incorporating a business, outlining the company's basic information and structure.</li>
            <li><span class="term">By-Laws:</span> Rules and regulations adopted by a corporation to govern its internal affairs and management.</li>
            <li><span class="term">Minutes of Meetings:</span> Official written records of discussions, decisions, and actions taken during corporate meetings, such as board meetings or shareholder meetings.</li>
            <li><span class="term">Share Certificates:</span> Legal documents that represent ownership of shares in a corporation, issued to shareholders.</li>
            <li><span class="term">Register of Directors and Officers:</span> A record that includes the names, addresses, and positions of the current directors and officers of a corporation.</li>
            <li><span class="term">Register of Shareholders:</span> A list of individuals or entities holding shares in a corporation, detailing the number and class of shares they own.</li>
            <li><span class="term">Consents and Resolutions:</span> Written consents or formal decisions made by directors or shareholders outside of regular meetings.</li>
            <li><span class="term">Securities Register:</span> The official record of all securities issued by the corporation, showing each issuance, transfer, cancellation and the current registered holder.</li>
            <li><span class="term">Organizational Resolutions:</span> The first resolutions passed by the directors (and confirmed by the shareholders) immediately after incorporation to organize the corporation, adopt by-laws, appoint officers, and issue initial shares.</li>
            <li><span class="term">Annual Resolutions:</span> Resolutions passed each year by the directors and shareholders in lieu of holding the annual meeting, dealing with election of directors, financial statements and the appointment or waiver of an auditor.</li>
            <li><span class="term">Unanimous Shareholders Agreement (USA):</span> A written agreement among all shareholders that may restrict, in whole or in part, the powers of the directors to manage the business and affairs of the corporation.</li>
            <li><span class="term">Resident Canadian:</span> An individual who is a Canadian citizen ordinarily resident in Canada, a member of a prescribed class of Canadian citizens not so resident, or a permanent resident as defined under federal immigration law and ordinarily resident in Canada.</li>
        </ol>
    </div>

    <!-- ============ TABLE OF CONTENTS ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Contents</div>
            <div class="name">Table of Contents</div>
            <div class="rule"></div>
        </div>
        <ul class="toc-list">
            <li><span><span class="num">I.</span><span class="label">Articles of Incorporation (with Schedules)</span></span></li>
            <li><span><span class="num">II.</span><span class="label">By-Law No. 1 — General By-Law</span></span></li>
            <li><span><span class="num">III.</span><span class="label">Organizational Resolutions of the First Directors</span></span></li>
            <li><span><span class="num">IV.</span><span class="label">Consents to Act as Director</span></span></li>
            <li><span><span class="num">V.</span><span class="label">Organizational Resolutions of the Shareholders</span></span></li>
            <li><span><span class="num">VI.</span><span class="label">Annual Resolutions of the Directors</span></span></li>
            <li><span><span class="num">VII.</span><span class="label">Annual Resolutions of the Shareholders</span></span></li>
            <li><span><span class="num">VIII.</span><span class="label">Corporate Resolutions &amp; Changes</span></span></li>
            <li><span><span class="num">IX.</span><span class="label">Share Subscriptions</span></span></li>
            <li><span><span class="num">X.</span><span class="label">Share Ledgers</span></span></li>
            <li><span><span class="num">XI.</span><span class="label">Share Transfer Register</span></span></li>
            <li><span><span class="num">XII.</span><span class="label">Corporate Registers</span></span></li>
            <li><span><span class="num">XIII.</span><span class="label">Share Certificates (Landscape Appendix)</span></span></li>
        </ul>
    </div>

    <!-- ============ I. ARTICLES ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section I</div>
            <div class="name">Articles of Incorporation</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>ARTICLES OF INCORPORATION</h1>
        <div class="section-block">
            <div class="section-block-title">1. Name of Corporation</div>
            <div><%= company.name %></div>
        </div>
        <div class="section-block">
            <div class="section-block-title">2. Corporate Access Number / Business Number</div>
            <div>CAN: <%= company.corporateAccessNumber || 'N/A' %></div>
            <div>BN: <%= company.businessNumber || 'N/A' %></div>
        </div>
        <div class="section-block">
            <div class="section-block-title">3. Registered Office</div>
            <div><%= company.registeredOfficeAddress.street %></div>
            <div><%= company.registeredOfficeAddress.city %>, <%= company.registeredOfficeAddress.province %> <%= company.registeredOfficeAddress.postalCode %></div>
            <div><%= company.registeredOfficeAddress.country %></div>
        </div>
        <div class="section-block">
            <div class="section-block-title">4. Records Address</div>
            <% if (!company.recordsAddress || company.recordsAddress.sameAsRegistered) { %>
                <div>Same as Registered Office.</div>
            <% } else { %>
                <div><%= company.recordsAddress.street %></div>
                <div><%= company.recordsAddress.city %>, <%= company.recordsAddress.province %> <%= company.recordsAddress.postalCode %></div>
                <div><%= company.recordsAddress.country || 'Canada' %></div>
            <% } %>
        </div>
        <div class="section-block">
            <div class="section-block-title">5. Address for Service by Mail</div>
            <% if (!company.addressForService || company.addressForService.sameAsRegistered) { %>
                <div>Same as Registered Office.</div>
            <% } else if (company.addressForService.sameAsRecords) { %>
                <div>Same as Records Address.</div>
            <% } else { %>
                <% if (company.addressForService.poBox) { %><div>PO Box <%= company.addressForService.poBox %></div><% } %>
                <% if (company.addressForService.street) { %><div><%= company.addressForService.street %></div><% } %>
                <div><%= company.addressForService.city || '' %>, <%= company.addressForService.province || '' %> <%= company.addressForService.postalCode || '' %></div>
                <div><%= company.addressForService.country || 'Canada' %></div>
            <% } %>
            <% if (company.addressForService && company.addressForService.email) { %>
                <div>Email: <%= company.addressForService.email %></div>
            <% } %>
        </div>
        <div class="section-block">
            <div class="section-block-title">6. Restrictions on Business</div>
            <% var rTo = company.restrictions && company.restrictions.restrictedTo;
               var rFrom = company.restrictions && company.restrictions.restrictedFrom;
               var legacy = company.restrictions && company.restrictions.hasRestrictions;
            %>
            <% if ((rTo && rTo.has) || (rFrom && rFrom.has)) { %>
                <% if (rTo && rTo.has) { %>
                    <div style="margin-top: 6px;"><strong>Business Restricted To:</strong></div>
                    <div style="white-space: pre-wrap;"><%= rTo.description %></div>
                <% } %>
                <% if (rFrom && rFrom.has) { %>
                    <div style="margin-top: 6px;"><strong>Business Restricted From:</strong></div>
                    <div style="white-space: pre-wrap;"><%= rFrom.description %></div>
                <% } %>
            <% } else if (legacy && company.restrictions.description) { %>
                <div style="white-space: pre-wrap;"><%= company.restrictions.description %></div>
            <% } else { %>
                <div>There are no restrictions on the business the Corporation may carry on.</div>
            <% } %>
        </div>
        <div class="section-block">
            <div class="section-block-title">7. Number of Directors</div>
            <div>Minimum: <%= company.minDirectors != null ? company.minDirectors : 1 %></div>
            <div>Maximum: <%= company.maxDirectors != null ? company.maxDirectors : 10 %></div>
        </div>
        <div class="section-block">
            <div class="section-block-title">8. Directors</div>
            <table>
                <thead><tr><th>Name</th><th>Address</th><th>Resident Canadian</th><th>Appointed</th></tr></thead>
                <tbody>
                    <% company.directors.forEach(function(d) { %>
                        <tr>
                            <td><%= d.name || ((d.firstName || '') + ' ' + (d.middleName || '') + ' ' + (d.lastName || '')).replace(/\s+/g,' ').trim() %></td>
                            <td><%= d.address %></td>
                            <td><%= d.residentCanadian === false ? 'No' : 'Yes' %></td>
                            <td><%= d.appointedDate ? new Date(d.appointedDate).toLocaleDateString() : '' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <div class="section-block">
            <div class="section-block-title">9. Authorized Share Capital</div>
            <% if (company.shareClasses && company.shareClasses.length > 0) { %>
                <table>
                    <thead><tr><th>Class</th><th>Type</th><th>Voting</th><th>Maximum Authorized</th><th>Par Value</th></tr></thead>
                    <tbody>
                        <% company.shareClasses.forEach(function(sc) { %>
                            <tr>
                                <td><%= sc.name %></td>
                                <td><%= sc.type %></td>
                                <td><%= sc.voting ? 'Voting' : 'Non-Voting' %></td>
                                <td><%= sc.maxAuthorized != null ? sc.maxAuthorized.toLocaleString() : 'Unlimited' %></td>
                                <td><%= sc.parValue != null ? '$' + sc.parValue : 'No par' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                <% var hasScheduleAInner = (company.schedules || []).some(function(s){ return /schedule\s*a/i.test(s.name); }); %>
                <% if (hasScheduleAInner) { %>
                    <p style="margin-top: 8px; font-style: italic; color: #555;">The rights, restrictions, conditions and limitations attaching to each class of shares are set out in <strong>Schedule A — Share Capital</strong>, attached and forming part of these Articles.</p>
                <% } else { %>
                    <p style="margin-top: 8px; font-style: italic; color: #555;">The rights, restrictions, conditions and limitations attaching to each class of shares shall be as determined by the directors of the Corporation by resolution from time to time.</p>
                <% } %>
            <% } else { %>
                <p style="font-style: italic;">No share classes defined.</p>
            <% } %>
        </div>
        <div class="section-block">
            <div class="section-block-title">10. Issued Shares</div>
            <table>
                <thead><tr><th>Shareholder</th><th>Type</th><th>Class</th><th>Shares</th><th>Voting %</th></tr></thead>
                <tbody>
                    <% company.shareholders.forEach(function(s) { %>
                        <tr>
                            <td>
                                <%= s.name %>
                                <% if (s.holderType === 'Legal Entity' && s.corporateAccessNumber) { %>
                                    <div style="font-size: 9pt; color: #666;">CAN: <%= s.corporateAccessNumber %></div>
                                <% } %>
                            </td>
                            <td><%= s.holderType || 'Individual' %></td>
                            <td><%= s.sharesClass %></td>
                            <td><%= s.numberOfShares %></td>
                            <td><%= s.votingPercent != null ? s.votingPercent + '%' : '—' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% if (company.schedules && company.schedules.length > 0) { %>
            <div class="section-block">
                <div class="section-block-title">11. Schedules Forming Part of these Articles</div>
                <ul>
                    <% company.schedules.forEach(function(s) { %>
                        <li><%= s.name %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>
        <div class="signature">
            <p>Dated: <%= today %></p>
            <% if (company.authorizedBy && company.authorizedBy.name) { %>
                <p style="margin-top: 24px;">Authorized by:</p>
                <div><strong><%= company.authorizedBy.name %></strong><% if (company.authorizedBy.company) { %>, <%= company.authorizedBy.company %><% } %></div>
                <div><%= company.authorizedBy.email %> &nbsp;|&nbsp; <%= company.authorizedBy.phone %></div>
                <div class="sig-line">Signature</div>
            <% } else { %>
                <div class="sig-line">Authorized Signature</div>
            <% } %>
        </div>
    </div>

    <% if (company.schedules && company.schedules.length > 0) { %>
        <% company.schedules.forEach(function(s) { %>
            <div class="page doc-content">
                <h1 style="margin-top: 60px;"><%= s.name %></h1>
                <p class="preamble">Forming part of the Articles of Incorporation of <%= company.name %></p>
                <div style="white-space: pre-wrap; text-align: justify; margin-top: 20px;"><%= s.content %></div>
            </div>
        <% }); %>
    <% } %>

    <!-- ============ II. BY-LAW NO. 1 ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section II</div>
            <div class="name">By-Law No. 1</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>BY-LAW NO. 1</h1>
        <p class="preamble">A by-law relating generally to the transaction of the business and affairs of</p>
        <h2><%= company.name %></h2>
        <p class="preamble">(the "Corporation")</p>

        <%- include('_by_laws_body', { company: company }) %>

        <div class="signature" style="page-break-before: always;">
            <p><strong>ENACTED</strong> by the directors of the Corporation, and <strong>CONFIRMED</strong> by the shareholders of the Corporation, this <%= today %>.</p>
            <div class="sig-block-title">Directors</div>
            <div class="sig-grid">
                <% company.directors.forEach(function(d) { %>
                    <div class="sig-cell">
                        <div class="sig-line"><%= d.name %>, Director</div>
                    </div>
                <% }); %>
            </div>
            <div class="sig-block-title">Shareholders</div>
            <div class="sig-grid">
                <% company.shareholders.forEach(function(s) { %>
                    <div class="sig-cell">
                        <div class="sig-line"><%= s.name %>, Shareholder</div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- ============ III. ORGANIZATIONAL RESOLUTION ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section III</div>
            <div class="name">Organizational Resolutions</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>RESOLUTIONS OF THE FIRST DIRECTORS</h1>
        <h2><%= company.name %></h2>
        <p class="preamble">(the "Corporation")</p>
        <p>The undersigned, being all of the first directors of the Corporation, hereby consent in writing to the following resolutions, in lieu of holding the organizational meeting of the directors:</p>

        <%- include('_organizational_body', { company: company, today: today, incorpDate: incorpDate }) %>

        <div class="signature">
            <p>DATED this <%= today %>.</p>
            <% company.directors.forEach(function(d) { %>
                <div class="sig-line"><%= d.name %>, Director</div>
            <% }); %>
        </div>
    </div>

    <!-- ============ IV. CONSENTS TO ACT ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section IV</div>
            <div class="name">Consents to Act as Director</div>
            <div class="rule"></div>
        </div>
    </div>
    <% company.directors.forEach(function(director) { %>
        <div class="page doc-content">
            <h1>CONSENT TO ACT AS DIRECTOR</h1>
            <h2><%= company.name %></h2>
            <p class="preamble">(the "Corporation")</p>
            <p style="margin-top: 28px; text-align: justify;">I, <strong><%= director.name %></strong>, of <%= director.address %>, hereby consent to act as a director of the Corporation, effective <%= director.appointedDate ? new Date(director.appointedDate).toLocaleDateString() : '_________________' %>.</p>
            <p style="text-align: justify;">I acknowledge that I am not disqualified under the applicable corporate legislation from acting as a director of the Corporation, and I undertake to notify the Corporation forthwith if I become so disqualified.</p>
            <div class="signature">
                <p>Date: <%= today %></p>
                <div class="sig-line"><%= director.name %></div>
                <div style="margin-top: 16px;">Witness: ___________________________________</div>
            </div>
        </div>
    <% }); %>

    <!-- ============ V. SHAREHOLDERS ORGANIZATIONAL RESOLUTION ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section V</div>
            <div class="name">Organizational Resolutions of the Shareholders</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>ORGANIZATIONAL RESOLUTIONS OF THE SHAREHOLDERS</h1>
        <h2><%= company.name %></h2>
        <p class="preamble">(the "Corporation")</p>
        <p><strong>BACKGROUND:</strong></p>
        <p>A. The first directors of the Corporation have taken the necessary steps to organize the Corporation following its incorporation under the applicable corporate legislation.</p>
        <p>B. The shareholders desire to elect directors for the ensuing year, confirm the by-laws enacted by the directors, and waive the appointment of an auditor.</p>
        <p style="margin-top: 18px;"><strong>IT IS RESOLVED THAT:</strong></p>

        <div class="section-block">
            <div class="section-block-title">1. Election of Directors</div>
            <div class="clause">RESOLVED THAT the following individuals are hereby elected as the Directors of the Corporation, to hold office for one year or until their successors are duly elected:</div>
            <ul>
                <% company.directors.forEach(function(d){ %>
                    <li><%= d.name %></li>
                <% }); %>
            </ul>
        </div>
        <div class="section-block">
            <div class="section-block-title">2. Consents to Act</div>
            <div class="clause">RESOLVED THAT the consent of each director to serve as a Director of the Corporation shall be obtained in writing and filed with the Secretary of the Corporation.</div>
        </div>
        <div class="section-block">
            <div class="section-block-title">3. Confirmation of By-Law No. 1</div>
            <div class="clause">RESOLVED THAT By-Law No. 1, being a by-law relating generally to the transaction of the business and affairs of the Corporation, as enacted by the directors, is hereby confirmed as a by-law of the Corporation.</div>
        </div>
        <div class="section-block">
            <div class="section-block-title">4. Waiver of Auditor</div>
            <div class="clause">RESOLVED THAT, the Corporation being a non-distributing corporation, the appointment of an auditor of the Corporation for the ensuing year is hereby waived by unanimous consent of all the shareholders entitled to vote, and the directors of the Corporation are hereby authorized to retain the services of an accountant or accounting firm to perform such accounting services as the directors may from time to time require.</div>
        </div>
        <div class="section-block">
            <div class="section-block-title">5. Ratification of Acts</div>
            <div class="clause">RESOLVED THAT all acts, contracts, by-laws, proceedings, appointments, elections and payments enacted, made, done and taken by the directors and officers of the Corporation since its incorporation are hereby approved, ratified and confirmed.</div>
        </div>

        <div class="signature">
            <p><strong>SIGNED</strong> by the shareholders of the Corporation entitled to vote on the foregoing resolutions, effective <%= today %>.</p>
            <% company.shareholders.forEach(function(s){ %>
                <div class="sig-line"><%= s.name %>, Shareholder</div>
            <% }); %>
        </div>
    </div>

    <!-- ============ VI. ANNUAL DIRECTOR RESOLUTION ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section VI</div>
            <div class="name">Annual Resolutions of the Directors</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>RESOLUTION OF THE DIRECTORS</h1>
        <h2><%= company.name %></h2>
        <p class="preamble">(the "Corporation")</p>
        <p>The undersigned, being all the directors of the Corporation, hereby consent in writing to the following resolutions:</p>

        <div class="section-block">
            <div class="section-block-title">1. Confirmation of Directors</div>
            <div class="clause">RESOLVED THAT the persons whose names appear below are confirmed as the directors of the Corporation:</div>
            <ul>
                <% company.directors.forEach(function(d){ %>
                    <li><%= d.name %> &mdash; appointed <%= d.appointedDate ? new Date(d.appointedDate).toLocaleDateString() : '' %></li>
                <% }); %>
            </ul>
        </div>
        <div class="section-block">
            <div class="section-block-title">2. Financial Statements</div>
            <div class="clause">RESOLVED THAT the unaudited financial statements of the Corporation for the fiscal year ending <%= company.fiscalYearEnd || 'December 31' %> are hereby approved as presented to the directors.</div>
        </div>
        <div class="section-block">
            <div class="section-block-title">3. General Authorization</div>
            <div class="clause">RESOLVED THAT any one director or officer of the Corporation is hereby authorized to execute and deliver all such documents as may be necessary or desirable to give effect to these resolutions.</div>
        </div>

        <div class="signature">
            <p>DATED this <%= today %>.</p>
            <% company.directors.forEach(function(d){ %>
                <div class="sig-line"><%= d.name %>, Director</div>
            <% }); %>
        </div>
    </div>

    <!-- ============ VII. ANNUAL SHAREHOLDER RESOLUTION ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section VII</div>
            <div class="name">Annual Resolutions of the Shareholders</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>RESOLUTION OF THE SHAREHOLDERS</h1>
        <h2><%= company.name %></h2>
        <p class="preamble">(the "Corporation")</p>
        <p>The undersigned, being all the shareholders of the Corporation entitled to vote, hereby consent in writing to the following resolutions in lieu of the annual meeting of shareholders:</p>

        <div class="section-block">
            <div class="section-block-title">1. Election of Directors</div>
            <div class="clause">RESOLVED THAT the following persons are elected as directors of the Corporation, to hold office until the next annual meeting:</div>
            <ul>
                <% company.directors.forEach(function(d){ %>
                    <li><%= d.name %></li>
                <% }); %>
            </ul>
        </div>
        <div class="section-block">
            <div class="section-block-title">2. Waiver of Auditor</div>
            <div class="clause">RESOLVED THAT, the Corporation being a non-distributing corporation, the appointment of an auditor for the ensuing year is waived by unanimous consent of all shareholders entitled to vote.</div>
        </div>
        <div class="section-block">
            <div class="section-block-title">3. Acts of Directors and Officers</div>
            <div class="clause">RESOLVED THAT all acts, contracts, by-laws, proceedings, appointments, elections and payments enacted, made, done and taken by the directors and officers of the Corporation are hereby approved, ratified and confirmed.</div>
        </div>

        <div class="signature">
            <p>DATED this <%= today %>.</p>
            <% company.shareholders.forEach(function(s){ %>
                <div class="sig-line"><%= s.name %>, Shareholder</div>
            <% }); %>
        </div>
    </div>

    <!-- ============ VIII. CORPORATE RESOLUTIONS & CHANGES ============ -->
    <%
        var CHANGE_EVENT_LABELS = {
            director_appointed: 'Director Appointed',
            director_resigned: 'Director Resigned',
            director_address_changed: "Director's Address Changed",
            address_changed: 'Registered Address Changed',
            shares_issued: 'Shares Issued',
            shares_transferred: 'Shares Transferred',
            shares_cancelled: 'Shares Cancelled',
            officer_appointed: 'Officer Appointed',
            officer_resigned: 'Officer Resigned',
            share_class_added: 'Share Class Added',
            fiscal_year_end_changed: 'Fiscal Year End Changed',
            name_changed: 'Company Name Changed',
            signing_authority_granted: 'Signing Authority Granted',
            signing_authority_revoked: 'Signing Authority Revoked',
            dividend_declared: 'Dividend Declared',
        };
        // Classification: which resolutions are signed by the board vs. the
        // shareholders. Under most Canadian corporate statutes, fundamental
        // changes (name change) + share transactions (transfer, cancel,
        // new class) are shareholder-class; day-to-day governance (director
        // + officer moves, addresses, dividends, signing authority) is
        // board-class. Buyers' counsel and auditors read the two sections
        // separately, so we render them separately.
        var BOARD_EVENT_TYPES = {
            director_appointed: 1, director_resigned: 1, director_address_changed: 1,
            officer_appointed: 1, officer_resigned: 1,
            address_changed: 1, fiscal_year_end_changed: 1,
            shares_issued: 1, dividend_declared: 1,
            signing_authority_granted: 1, signing_authority_revoked: 1,
        };
        var SHAREHOLDER_EVENT_TYPES = {
            name_changed: 1, share_class_added: 1,
            shares_transferred: 1, shares_cancelled: 1,
        };
        var allChangeEvents = (events || []).filter(function(e){ return e.eventType !== 'annual_return_filed'; });
        var boardResolutions       = allChangeEvents.filter(function(e){ return BOARD_EVENT_TYPES[e.eventType]; });
        var shareholderResolutions = allChangeEvents.filter(function(e){ return SHAREHOLDER_EVENT_TYPES[e.eventType]; });
        var annualReturnEventsForSection = (events || []).filter(function(e){ return e.eventType === 'annual_return_filed'; });
        function evtSummary(type, data) {
            var d = data || {};
            if (type === 'director_appointed') return [d.firstName, d.middleName, d.lastName].filter(Boolean).join(' ');
            if (type === 'director_resigned') return d.directorName || '';
            if (type === 'director_address_changed') return (d.directorName || '') + ' → ' + (d.newAddress || '');
            if (type === 'address_changed') return (d.addressType === 'registered' ? 'Registered Office' : d.addressType === 'records' ? 'Records' : 'Service') + ' updated';
            if (type === 'shares_issued') return (d.numberOfShares || '') + ' ' + (d.sharesClass || '') + ' → ' + (d.name || '');
            if (type === 'shares_transferred') return (d.numberOfShares || '') + ' ' + (d.sharesClass || '') + ': ' + (d.fromName || '') + ' → ' + (d.toName || '');
            if (type === 'shares_cancelled') return (d.numberOfShares || '') + ' ' + (d.sharesClass || '') + ' cancelled from ' + (d.holderName || '');
            if (type === 'officer_appointed') return (d.name || '') + ' as ' + (d.title || '');
            if (type === 'officer_resigned') return d.officerName || '';
            if (type === 'share_class_added') return d.name || '';
            if (type === 'fiscal_year_end_changed') return 'New year-end: ' + (d.newFiscalYearEnd || '');
            if (type === 'name_changed') return 'New name: ' + (d.newName || '');
            if (type === 'signing_authority_granted') {
                var so = d.signingOfficerName || '';
                var t  = d.title ? ' (' + d.title + ')' : '';
                var s  = d.scope ? ' — ' + d.scope : '';
                return so + t + s;
            }
            if (type === 'signing_authority_revoked') {
                var so2 = d.signingOfficerName || '';
                var r   = d.reason ? ' — ' + d.reason : '';
                return so2 + r;
            }
            if (type === 'dividend_declared') {
                var cls = d.shareClass || '';
                var ps  = (d.perShareAmount != null) ? ('$' + Number(d.perShareAmount).toFixed(2) + '/share') : '';
                var tot = (d.totalAmount != null) ? ('$' + Number(d.totalAmount).toFixed(2) + ' total') : '';
                return [cls, ps, tot].filter(Boolean).join(' · ');
            }
            return '';
        }
        function renderResolutionsTable(list) {
            var registryTypes = ['director_appointed','director_resigned','director_address_changed','address_changed','name_changed','shares_transferred','shares_issued','shares_cancelled','share_class_added'];
            var out = '<table><thead><tr>' +
                '<th style="width: 100px;">Date</th>' +
                '<th style="width: 160px;">Event Type</th>' +
                '<th>Details</th>' +
                '<th style="width: 90px; text-align:center;">Resolution</th>' +
                '<th style="width: 90px; text-align:center;">Registry<br>Filing</th>' +
                '</tr></thead><tbody>';
            list.forEach(function(ev) {
                var hasRes = (ev.attachments || []).some(function(a){ return a.role === 'resolution'; });
                var hasReg = (ev.attachments || []).some(function(a){ return a.role === 'registry_filing'; });
                var needsReg = registryTypes.indexOf(ev.eventType) !== -1;
                out += '<tr>';
                out += '<td>' + new Date(ev.effectiveDate).toLocaleDateString() + '</td>';
                out += '<td>' + (CHANGE_EVENT_LABELS[ev.eventType] || ev.eventType) + '</td>';
                out += '<td style="font-size: 10pt;">' + evtSummary(ev.eventType, ev.data);
                if (ev.notes) out += '<div style="color:#888; font-size:9.5pt;">' + ev.notes + '</div>';
                out += '</td>';
                out += '<td style="text-align:center; font-size: 10pt;">' + (hasRes ? '✓ Attached' : '—') + '</td>';
                out += '<td style="text-align:center; font-size: 10pt;">' + (needsReg ? (hasReg ? '✓ Attached' : '—') : '<span style="color:#aaa;">N/A</span>') + '</td>';
                out += '</tr>';
            });
            out += '</tbody></table>';
            return out;
        }
    %>
    <div class="page">
        <div class="section-title">
            <div class="num">Section VIII</div>
            <div class="name">Corporate Resolutions &amp; Changes</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1>CORPORATE RESOLUTIONS &amp; CHANGES</h1>
        <h2><%= company.name %></h2>
        <p class="preamble">(the "Corporation")</p>
        <p style="font-size: 10.5pt; color: #555; margin-bottom: 18px;">
            This section records all corporate changes made after incorporation. Signed resolutions and official registry filing confirmations are attached as individual documents following this section.
        </p>

        <% if (boardResolutions.length === 0 && shareholderResolutions.length === 0) { %>
            <p style="font-style: italic; color: #888;">No corporate change events have been recorded.</p>
        <% } else { %>
            <div class="section-block">
                <div class="section-block-title">Board (Director) Resolutions</div>
                <p style="font-size: 10pt; color: #666; margin-bottom: 8px;">
                    Day-to-day governance decisions signed by the directors — director / officer appointments and resignations, address changes, share issuances under existing authority, dividend declarations, and signing-authority grants.
                </p>
                <% if (boardResolutions.length === 0) { %>
                    <p style="font-style: italic; color: #888;">None on record.</p>
                <% } else { %>
                    <%- renderResolutionsTable(boardResolutions) %>
                <% } %>
            </div>

            <div class="section-block" style="margin-top: 28px;">
                <div class="section-block-title">Shareholders' Resolutions</div>
                <p style="font-size: 10pt; color: #666; margin-bottom: 8px;">
                    Fundamental changes and share-transaction decisions requiring shareholder approval — name change, new share classes, share transfers and cancellations.
                </p>
                <% if (shareholderResolutions.length === 0) { %>
                    <p style="font-style: italic; color: #888;">None on record.</p>
                <% } else { %>
                    <%- renderResolutionsTable(shareholderResolutions) %>
                <% } %>
            </div>
        <% } %>

        <% if (annualReturnEventsForSection.length > 0) { %>
            <div class="section-block" style="margin-top: 28px;">
                <div class="section-block-title">Annual Returns Filed</div>
                <table>
                    <thead>
                        <tr>
                            <th style="width: 100px;">Date Filed</th>
                            <th style="width: 80px;">FY</th>
                            <th>Confirmation No.</th>
                            <th style="width: 90px; text-align:center;">Document<br>Attached</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% annualReturnEventsForSection.forEach(function(ev) { %>
                            <%
                                var hasDoc = (ev.attachments || []).some(function(a){ return a.role === 'registry_filing'; });
                            %>
                            <tr>
                                <td><%= new Date(ev.effectiveDate).toLocaleDateString() %></td>
                                <td><%= (ev.data && ev.data.year) ? ev.data.year : '—' %></td>
                                <td style="font-size: 10pt;"><%= (ev.data && ev.data.confirmationNumber) ? ev.data.confirmationNumber : '—' %></td>
                                <td style="text-align:center; font-size: 10pt;"><%= hasDoc ? '✓ Attached' : '—' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- ============ IX. SHARE SUBSCRIPTIONS ============ -->
    <%
        var classByName = {};
        (company.shareClasses || []).forEach(function(sc){ classByName[sc.name] = sc; });
        var lookupPar = function(className) {
            var sc = classByName[className];
            return sc && sc.parValue != null ? sc.parValue : 1;
        };
    %>
    <div class="page">
        <div class="section-title">
            <div class="num">Section IX</div>
            <div class="name">Share Subscriptions</div>
            <div class="rule"></div>
        </div>
    </div>
    <% (company.shareholders || []).forEach(function(s){ %>
        <% var par = lookupPar(s.sharesClass); var totalPrice = (par * (s.numberOfShares || 0)).toFixed(2); %>
        <div class="page doc-content">
            <h1 style="margin-top: 30px;">SHARE SUBSCRIPTION</h1>
            <p style="margin-top: 18px;"><strong>TO:</strong> <%= company.name %> (the "Corporation")</p>
            <p><strong>TO:</strong> THE DIRECTORS OF <%= company.name.toUpperCase() %></p>
            <p style="margin-top: 16px; text-align: justify;">The undersigned subscribes for and agrees to take <strong><%= s.numberOfShares %></strong> <strong><%= s.sharesClass %></strong> of the capital of the Corporation and tenders herewith the sum of <strong>$<%= totalPrice %></strong> in full payment of the subscription price for these shares.</p>
            <p style="text-align: justify;">The undersigned hereby requests that the said shares be allotted to the undersigned, that the shares be issued as fully paid and non-assessable, and that a certificate for the shares be issued to the undersigned.</p>
            <p style="margin-top: 16px;">DATED effective <%= company.incorporationDate ? new Date(company.incorporationDate).toLocaleDateString() : today %>.</p>
            <div class="signature">
                <div class="sig-line"><%= s.name %></div>
                <% if (s.holderType === 'Legal Entity') { %>
                    <% if (s.corporateAccessNumber) { %><div style="font-size: 10pt; color: #555;">Corporate Access Number: <%= s.corporateAccessNumber %></div><% } %>
                    <% if (s.businessNumber) { %><div style="font-size: 10pt; color: #555;">Business Number: <%= s.businessNumber %></div><% } %>
                <% } %>
                <% if (s.address) { %><div style="font-size: 10pt; color: #555;"><%= s.address %></div><% } %>
            </div>
        </div>
    <% }); %>

    <!-- ============ X. SHARE LEDGERS ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section X</div>
            <div class="name">Share Ledgers</div>
            <div class="rule"></div>
        </div>
    </div>
    <% (company.shareholders || []).forEach(function(s, holderIdx){ %>
        <% var ledgerPar = lookupPar(s.sharesClass); var ledgerPaid = (ledgerPar * (s.numberOfShares || 0)).toFixed(2); %>
        <div class="page doc-content">
            <h1 style="margin-top: 30px; font-size: 18pt;">SHARE LEDGER</h1>
            <p class="preamble"><%= company.name %></p>
            <div style="margin-top: 18px;">
                <div style="font-weight: bold; font-size: 12pt;">Holder: <%= s.name %></div>
                <div style="font-size: 10pt; color: #555;">
                    <%= s.holderType || 'Individual' %>
                    <% if (s.holderType === 'Legal Entity' && s.corporateAccessNumber) { %> &mdash; CAN <%= s.corporateAccessNumber %><% } %>
                    <% if (s.holderType === 'Legal Entity' && s.businessNumber) { %> &mdash; BN <%= s.businessNumber %><% } %>
                </div>
                <% if (s.address) { %><div style="font-size: 10pt; color: #555;"><%= s.address %></div><% } %>
                <div style="font-size: 10pt; color: #555;">Class of Shares: <strong><%= s.sharesClass %></strong></div>
            </div>
            <table style="margin-top: 12px;">
                <thead>
                    <tr><th>Date</th><th>Cert. Issued</th><th>Cert. Cancelled</th><th>Transfer No.</th><th>To / From</th><th>Paid Up</th><th>Sold</th><th>Bought</th><th>Balance</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%= company.incorporationDate ? new Date(company.incorporationDate).toLocaleDateString() : today %></td>
                        <td>A<%= holderIdx + 1 %></td>
                        <td>—</td>
                        <td>Initial</td>
                        <td>From Treasury</td>
                        <td>$<%= ledgerPaid %></td>
                        <td>—</td>
                        <td><%= s.numberOfShares %></td>
                        <td><strong><%= s.numberOfShares %></strong></td>
                    </tr>
                    <% for (var r = 0; r < 8; r++) { %>
                        <tr style="height: 24px;"><td colspan="9" style="color: #ccc; text-align: center; font-style: italic;">&nbsp;</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% }); %>

    <!-- ============ XI. SHARE TRANSFER REGISTER ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section XI</div>
            <div class="name">Share Transfer Register</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <h1 style="margin-top: 30px; font-size: 18pt;">SHARE TRANSFER REGISTER</h1>
        <p class="preamble"><%= company.name %></p>
        <p style="font-size: 10.5pt; color: #555; margin-top: 8px;">Chronological record of every issuance and transfer of shares of the Corporation.</p>
        <table style="margin-top: 8px;">
            <thead>
                <tr><th>No.</th><th>Date</th><th>Class</th><th>Cert. Surrendered</th><th>Transferor</th><th>Transferee</th><th>Address</th><th>Cert. Issued</th></tr>
            </thead>
            <tbody>
                <% (company.shareholders || []).forEach(function(s, idx) { %>
                    <tr>
                        <td><%= idx + 1 %></td>
                        <td><%= company.incorporationDate ? new Date(company.incorporationDate).toLocaleDateString() : today %></td>
                        <td><%= s.sharesClass %></td>
                        <td>—</td>
                        <td>From Treasury</td>
                        <td><%= s.name %></td>
                        <td><%= s.address || '' %></td>
                        <td>A<%= idx + 1 %> / <%= s.numberOfShares %></td>
                    </tr>
                <% }); %>
                <% for (var r = 0; r < 10; r++) { %>
                    <tr style="height: 22px;"><td colspan="8" style="color: #ccc; text-align: center; font-style: italic;">&nbsp;</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- ============ XII. REGISTERS ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section XII</div>
            <div class="name">Corporate Registers</div>
            <div class="rule"></div>
        </div>
    </div>
    <div class="page doc-content">
        <%- include('_registers_body', { company: company, events: events || [] }) %>
    </div>

    <!-- ============ XIII. SHARE CERTIFICATES (DIVIDER ONLY — landscape pages appended via pdf-lib) ============ -->
    <div class="page">
        <div class="section-title">
            <div class="num">Section XIII</div>
            <div class="name">Share Certificates</div>
            <div class="rule"></div>
            <p style="margin-top: 24px; font-style: italic; color: #555; font-size: 11pt;">The share certificates of the Corporation follow this page in landscape orientation.</p>
        </div>
    </div>
</body>

</html>
