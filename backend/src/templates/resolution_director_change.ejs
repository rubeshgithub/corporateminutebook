<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Board Resolution — <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 44px; line-height: 1.65; font-size: 11pt; color: #1a1a1a; }
        .company-name { text-align: center; font-size: 21px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 2px; }
        .res-type { text-align: center; font-size: 15px; font-weight: bold; margin: 3px 0; }
        .res-sub { text-align: center; font-size: 13px; color: #444; margin: 2px 0 6px 0; }
        .eff-date { text-align: center; font-size: 12px; color: #555; margin-bottom: 20px; }
        hr { border: none; border-top: 1.5px solid #333; margin: 18px 0; }
        table { width: 100%; border-collapse: collapse; margin: 14px 0 20px 0; font-size: 10.5pt; }
        th { background: #2c3e50; color: #fff; padding: 8px 10px; text-align: left; font-size: 10pt; font-weight: 600; }
        td { padding: 7px 10px; border: 1px solid #ccc; vertical-align: top; }
        tr:nth-child(even) td { background: #f7f7f7; }
        .section { margin: 18px 0; }
        .resolved { font-weight: bold; text-transform: uppercase; font-size: 10.5pt; margin-bottom: 6px; }
        .date-line { margin-top: 44px; font-size: 11pt; }
        .sig-section { margin-top: 36px; }
        .sig-grid { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 10px; }
        .sig-block { flex: 1; min-width: 160px; }
        .sig-line { border-top: 1px solid #000; margin-top: 52px; padding-top: 5px; font-size: 10pt; line-height: 1.5; }
    </style>
</head>
<body>
<%
    var ev = (typeof event !== 'undefined' && event) ? event : {};
    var d = ev.data || {};
    var effDate = ev.effectiveDate ? new Date(ev.effectiveDate) : new Date();
    var effDateStr = effDate.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

    var activeDirectors = (company.directors || []).filter(function(dir) { return !dir.resignedDate; });
    var dirName = function(dir) {
        return dir.name || ([dir.firstName, dir.middleName, dir.lastName].filter(Boolean).join(' ').trim()) || '';
    };

    var titleMap = {
        'director_appointed': 'Appointment of Director',
        'director_resigned': 'Resignation of Director',
        'director_address_changed': "Change of Director's Address",
        'officer_appointed': 'Appointment of Officer',
        'officer_resigned': 'Resignation of Officer',
    };
    var resolvedTitle = titleMap[ev.eventType] || 'Director / Officer Change';

    var personName = d.directorName || d.officerName || d.name ||
        [d.firstName, d.middleName, d.lastName].filter(Boolean).join(' ').trim() || '';
    var isOfficer = (ev.eventType === 'officer_appointed' || ev.eventType === 'officer_resigned');
    var personRole = isOfficer ? (d.title || 'Officer') : 'Director';

    var changeType = '';
    if (ev.eventType === 'director_appointed' || ev.eventType === 'officer_appointed') changeType = 'Appointed';
    else if (ev.eventType === 'director_resigned' || ev.eventType === 'officer_resigned') changeType = 'Resigned';
    else if (ev.eventType === 'director_address_changed') changeType = 'Address Updated';
%>

<div class="company-name"><%= company.name %></div>
<div class="res-type">Board Resolution</div>
<div class="res-sub"><%= resolvedTitle %></div>
<div class="eff-date">Effective <%= effDateStr %></div>

<hr>

<div class="section">
    <p>The following resolution has been duly approved and enacted by the Directors of
    <strong><%= company.name %></strong> (the "Corporation") effective <%= effDateStr %>:</p>
</div>

<div class="section">
    <div class="resolved">Changes to Directors / Officers with Registry:</div>
    <table>
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Name</th>
                <th>Role</th>
                <th>Change</th>
                <% if (ev.eventType === 'director_appointed') { %><th>Resident Canadian</th><% } %>
                <% if (ev.eventType === 'director_address_changed') { %><th>New Address</th><% } %>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= effDateStr %></td>
                <td><%= personName %></td>
                <td><%= personRole %></td>
                <td><%= changeType %></td>
                <% if (ev.eventType === 'director_appointed') { %>
                    <td><%= d.residentCanadian !== false ? 'Yes' : 'No' %></td>
                <% } %>
                <% if (ev.eventType === 'director_address_changed') { %>
                    <td><%= d.newAddress || '' %></td>
                <% } %>
            </tr>
        </tbody>
    </table>
    <% if (ev.eventType === 'director_appointed' && d.address) { %>
        <p style="font-size:10.5pt;"><strong>Residential Address:</strong> <%= d.address %></p>
    <% } %>
</div>

<div class="section">
    <div class="resolved">It is hereby resolved that:</div>
    <% if (ev.eventType === 'director_appointed' || ev.eventType === 'officer_appointed') { %>
        <p><%= personName %> is hereby appointed as <%= personRole %> of the Corporation effective <%= effDateStr %>,
        having consented in writing to act in such capacity.</p>
    <% } else if (ev.eventType === 'director_resigned' || ev.eventType === 'officer_resigned') { %>
        <p>The resignation of <strong><%= personName %></strong> as <%= personRole %> of the Corporation is
        hereby accepted effective <%= effDateStr %>.</p>
    <% } else if (ev.eventType === 'director_address_changed') { %>
        <p>The address of <strong><%= personName %></strong>, <%= personRole %> of the Corporation, is hereby
        updated to <strong><%= d.newAddress || '' %></strong> effective <%= effDateStr %>.</p>
    <% } %>
</div>

<div class="section">
    <div class="resolved">It is further resolved that:</div>
    <p>Any changes to the Director / Officer register or corporate registry filings will have to be approved
    and signed by the Directors of the Corporation. Any officer or director of the Corporation is hereby
    authorized to execute and deliver all such documents and to do all such acts and things as may be
    necessary or desirable to give effect to the foregoing resolutions, including filing any required notice
    with the applicable corporate registry.</p>
</div>

<% if (ev.notes) { %>
<div class="section">
    <p><strong>Notes:</strong> <%= ev.notes %></p>
</div>
<% } %>

<div class="date-line">DATE: ___________________________________</div>

<div class="sig-section">
    <div class="resolved">Signed:</div>
    <div class="sig-grid">
        <% activeDirectors.forEach(function(dir) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= company.name %></strong><br>
                <%= dirName(dir) %><br>
                Director
            </div>
        </div>
        <% }); %>
        <% if (changeType === 'Resigned' && personName) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= company.name %></strong><br>
                <%= personName %><br>
                <%= personRole %> (Resigning)
            </div>
        </div>
        <% } %>
    </div>
</div>

</body>
</html>
