<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Board Resolution — <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 44px; line-height: 1.65; font-size: 11pt; color: #1a1a1a; }
        .company-name { text-align: center; font-size: 21px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 2px; }
        .res-type { text-align: center; font-size: 15px; font-weight: bold; margin: 3px 0; }
        .res-sub { text-align: center; font-size: 13px; color: #444; margin: 2px 0 6px 0; }
        .eff-date { text-align: center; font-size: 12px; color: #555; margin-bottom: 20px; }
        hr { border: none; border-top: 1.5px solid #333; margin: 18px 0; }
        table { width: 100%; border-collapse: collapse; margin: 14px 0 20px 0; font-size: 10.5pt; }
        th { background: #2c3e50; color: #fff; padding: 8px 10px; text-align: left; font-size: 10pt; font-weight: 600; }
        td { padding: 7px 10px; border: 1px solid #ccc; vertical-align: top; }
        tr:nth-child(even) td { background: #f7f7f7; }
        .section { margin: 18px 0; }
        .resolved { font-weight: bold; text-transform: uppercase; font-size: 10.5pt; margin-bottom: 6px; }
        .date-line { margin-top: 44px; font-size: 11pt; }
        .sig-section { margin-top: 36px; }
        .sig-grid { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 10px; }
        .sig-block { flex: 1; min-width: 160px; }
        .sig-line { border-top: 1px solid #000; margin-top: 52px; padding-top: 5px; font-size: 10pt; line-height: 1.5; }
    </style>
</head>
<body>
<%
    var ev = (typeof event !== 'undefined' && event) ? event : {};
    var d = ev.data || {};
    var effDate = ev.effectiveDate ? new Date(ev.effectiveDate) : new Date();
    var effDateStr = effDate.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

    var activeDirectors = (company.directors || []).filter(function(dir) { return !dir.resignedDate; });
    var dirName = function(dir) {
        return dir.name || ([dir.firstName, dir.middleName, dir.lastName].filter(Boolean).join(' ').trim()) || '';
    };

    var addrTypeLabel = {
        'registered': 'Registered Office',
        'records': 'Records Address',
        'service': 'Address for Service',
    };

    // Compose new address string
    var newAddr = d.address || {};
    var newAddrStr = [newAddr.street, newAddr.city, newAddr.province, newAddr.postalCode].filter(Boolean).join(', ');
    var addrLabel = addrTypeLabel[d.addressType] || d.addressType || 'Address';

    // Get the current (old) address from company snapshot for reference
    var addrFieldMap = { 'registered': 'registeredOfficeAddress', 'records': 'recordsAddress', 'service': 'addressForService' };
    var oldAddrObj = company[addrFieldMap[d.addressType]] || {};
    var oldAddrStr = [oldAddrObj.street, oldAddrObj.city, oldAddrObj.province, oldAddrObj.postalCode].filter(Boolean).join(', ') || '—';
%>

<div class="company-name"><%= company.name %></div>
<div class="res-type">Board Resolution</div>
<div class="res-sub">Change of <%= addrLabel %></div>
<div class="eff-date">Effective <%= effDateStr %></div>

<hr>

<div class="section">
    <p>The following resolution has been duly approved and enacted by the Directors of
    <strong><%= company.name %></strong> (the "Corporation") effective <%= effDateStr %>:</p>
</div>

<div class="section">
    <div class="resolved">Change of Address:</div>
    <table>
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Address Type</th>
                <th>Previous Address</th>
                <th>New Address</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= effDateStr %></td>
                <td><%= addrLabel %></td>
                <td><%= oldAddrStr %></td>
                <td><%= newAddrStr %></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section">
    <div class="resolved">It is hereby resolved that:</div>
    <p>The <strong><%= addrLabel %></strong> of the Corporation is hereby changed to
    <strong><%= newAddrStr %></strong>, effective <%= effDateStr %>.</p>
</div>

<div class="section">
    <div class="resolved">It is further resolved that:</div>
    <p>Any changes to the registered address of the Corporation will require approval by the Directors.
    Any officer or director of the Corporation is hereby authorized to execute and deliver all such
    documents and to do all such acts and things as may be necessary or desirable to give full force
    and effect to the foregoing resolutions, including the filing of any required notice with the
    applicable corporate registry.</p>
</div>

<% if (ev.notes) { %>
<div class="section">
    <p><strong>Notes:</strong> <%= ev.notes %></p>
</div>
<% } %>

<div class="date-line">DATE: ___________________________________</div>

<div class="sig-section">
    <div class="resolved">Signed:</div>
    <div class="sig-grid">
        <% activeDirectors.forEach(function(dir) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= company.name %></strong><br>
                <%= dirName(dir) %><br>
                Director
            </div>
        </div>
        <% }); %>
    </div>
</div>

</body>
</html>
