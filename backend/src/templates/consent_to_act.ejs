<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Consent to Act as Director - <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 0; line-height: 1.7; font-size: 12pt; }
        h1 { text-align: center; font-size: 22px; text-decoration: underline; margin-bottom: 6px; }
        h2 { text-align: center; font-size: 16px; margin-top: 6px; }
        .preamble { text-align: center; font-style: italic; margin-bottom: 24px; }
        .body { margin-top: 28px; text-align: justify; }
        .signature { margin-top: 70px; }
        .sig-line { border-top: 1px solid #000; width: 320px; margin-top: 50px; padding-top: 4px; }
        .field { margin-top: 10px; }
        .field-label { display: inline-block; width: 140px; font-weight: bold; }
        .consent-page { page-break-after: always; }
        .consent-page:last-child { page-break-after: auto; }
    </style>
</head>

<body>
    <% company.directors.forEach(function(director) { %>
        <div class="consent-page">
            <h1>CONSENT TO ACT AS DIRECTOR</h1>
            <h2><%= company.name %></h2>
            <p class="preamble">(the "Corporation")</p>

            <div class="body">
                <p>I, <strong><%= director.name %></strong>, of <%= [director.address, director.city, director.province, director.postalCode].filter(Boolean).join(', ') %>, hereby consent to act as a director of the Corporation, effective <%= director.appointedDate ? new Date(director.appointedDate).toLocaleDateString() : '_________________' %>.</p>

                <p>I acknowledge that I am not disqualified under the applicable corporate legislation from acting as a director of the Corporation, and I undertake to notify the Corporation forthwith if I become so disqualified.</p>
            </div>

            <div class="signature">
                <div class="field"><span class="field-label">Date:</span> <%= new Date().toLocaleDateString() %></div>
                <div class="sig-line"><%= director.name %></div>
                <div class="field"><span class="field-label">Witness:</span> ___________________________________</div>
            </div>
        </div>
    <% }); %>
</body>

</html>
