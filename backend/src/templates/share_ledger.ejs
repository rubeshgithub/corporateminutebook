<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Share Ledgers - <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 30px; line-height: 1.4; font-size: 10.5pt; color: #1a1a1a; }
        h1 { text-align: center; font-size: 18pt; font-weight: 700; margin-bottom: 6px; text-decoration: underline; }
        .corp-name { text-align: center; font-style: italic; margin-bottom: 18px; font-size: 11pt; }
        .ledger { page-break-after: always; }
        .ledger:last-child { page-break-after: auto; }
        .holder-block { margin-top: 14px; margin-bottom: 8px; }
        .holder-name { font-weight: bold; font-size: 12pt; }
        .holder-meta { font-size: 10pt; color: #555; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th, td { border: 1px solid #555; padding: 6px 8px; text-align: left; font-size: 10pt; }
        th { background: #f3f3f3; font-weight: bold; }
        .empty-row td { color: #aaa; font-style: italic; text-align: center; }
    </style>
</head>

<body>
    <%
        var shareEvents = (events || []).filter(function(e) {
            return e.eventType === 'shares_issued' || e.eventType === 'shares_transferred' || e.eventType === 'shares_cancelled';
        });
        var hasEvents = shareEvents.length > 0;

        var classByName = {};
        (company.shareClasses || []).forEach(function(sc){ classByName[sc.name] = sc; });
        var lookupPar = function(className) {
            var sc = classByName[className];
            return sc && sc.parValue != null ? sc.parValue : 1;
        };
        // Stored dates are UTC midnight (date-only) — format in UTC or servers
        // west of UTC print the previous day.
        var fmtDate = function(d) { return d ? new Date(d).toLocaleDateString(undefined, { timeZone: 'UTC' }) : ''; };
        var fmtMoney = function(n) { return n != null ? '$' + Number(n).toFixed(2) : '—'; };
    %>

    <% (company.shareholders || []).forEach(function(s, holderIdx) { %>
        <%
            var par = lookupPar(s.sharesClass);
            // Build rows from events for this holder+class, falling back to snapshot row
            var rows = [];
            if (hasEvents) {
                shareEvents.forEach(function(e) {
                    var d = e.data || {};
                    if (e.eventType === 'shares_issued' && d.name === s.name && d.sharesClass === s.sharesClass) {
                        rows.push({
                            date: fmtDate(e.effectiveDate),
                            certIssued: d.certificateNumber ? 'A' + d.certificateNumber : '',
                            certCancelled: '—',
                            transferNo: 'Initial',
                            toFrom: 'From Treasury',
                            paidUp: d.considerationPaid != null ? fmtMoney(d.considerationPaid) : fmtMoney(par * (d.numberOfShares || 0)),
                            sold: '—',
                            bought: d.numberOfShares || 0,
                        });
                    } else if (e.eventType === 'shares_transferred') {
                        if (d.fromName === s.name && d.sharesClass === s.sharesClass) {
                            rows.push({
                                date: fmtDate(e.effectiveDate),
                                certIssued: '—',
                                certCancelled: d.certificateNumberSurrendered ? 'A' + d.certificateNumberSurrendered : '—',
                                transferNo: 'Transfer',
                                toFrom: 'To ' + (d.toName || ''),
                                paidUp: d.consideration != null ? fmtMoney(d.consideration) : '—',
                                sold: d.numberOfShares || 0,
                                bought: '—',
                            });
                        }
                        if (d.toName === s.name && d.sharesClass === s.sharesClass) {
                            rows.push({
                                date: fmtDate(e.effectiveDate),
                                certIssued: d.certificateNumberIssued ? 'A' + d.certificateNumberIssued : '',
                                certCancelled: '—',
                                transferNo: 'Transfer',
                                toFrom: 'From ' + (d.fromName || ''),
                                paidUp: d.consideration != null ? fmtMoney(d.consideration) : '—',
                                sold: '—',
                                bought: d.numberOfShares || 0,
                            });
                        }
                    } else if (e.eventType === 'shares_cancelled' && d.holderName === s.name && d.sharesClass === s.sharesClass) {
                        rows.push({
                            date: fmtDate(e.effectiveDate),
                            certIssued: '—',
                            certCancelled: d.certificateNumber ? 'A' + d.certificateNumber : '—',
                            transferNo: 'Cancellation',
                            toFrom: '—',
                            paidUp: '—',
                            sold: d.numberOfShares || 0,
                            bought: '—',
                        });
                    }
                });
            }
            if (rows.length === 0) {
                // Fallback: single initial issuance row from Company snapshot
                var initPaidUp = s.considerationPaid != null ? fmtMoney(s.considerationPaid) : fmtMoney(par * (s.numberOfShares || 0));
                rows.push({
                    date: fmtDate(s.issuanceDate || company.incorporationDate),
                    certIssued: s.certificateNumber ? 'A' + s.certificateNumber : 'A' + (holderIdx + 1),
                    certCancelled: '—',
                    transferNo: 'Initial',
                    toFrom: 'From Treasury',
                    paidUp: initPaidUp,
                    sold: '—',
                    bought: s.numberOfShares,
                });
            }
            // Compute running balance
            var balance = 0;
        %>
        <div class="ledger">
            <h1>SHARE LEDGER</h1>
            <div class="corp-name"><%= company.name %></div>

            <div class="holder-block">
                <div class="holder-name">Holder: <%= s.name %></div>
                <div class="holder-meta">
                    <%= s.holderType || 'Individual' %>
                    <% if (s.holderType === 'Legal Entity' && s.corporateAccessNumber) { %> &mdash; CAN <%= s.corporateAccessNumber %><% } %>
                    <% if (s.holderType === 'Legal Entity' && s.businessNumber) { %> &mdash; BN <%= s.businessNumber %><% } %>
                </div>
                <% var sFullAddr = [s.address, s.city, s.province, s.postalCode, s.country].filter(Boolean).join(', '); %>
                <% if (sFullAddr) { %><div class="holder-meta"><%= sFullAddr %></div><% } %>
                <div class="holder-meta">Class of Shares: <strong><%= s.sharesClass %></strong></div>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Cert. No.<br/>Issued</th>
                        <th>Cert. No.<br/>Cancelled</th>
                        <th>Transfer No.</th>
                        <th>To / From Whom</th>
                        <th>Paid Up</th>
                        <th>Sold</th>
                        <th>Bought</th>
                        <th>Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <% rows.forEach(function(row) {
                        var bought = parseInt(row.bought) || 0;
                        var sold = parseInt(row.sold) || 0;
                        balance = balance + bought - sold;
                    %>
                    <tr>
                        <td><%= row.date %></td>
                        <td><%= row.certIssued %></td>
                        <td><%= row.certCancelled %></td>
                        <td><%= row.transferNo %></td>
                        <td><%= row.toFrom %></td>
                        <td><%= row.paidUp %></td>
                        <td><%= row.sold %></td>
                        <td><%= row.bought %></td>
                        <td><strong><%= balance %></strong></td>
                    </tr>
                    <% }); %>
                    <% var blankRows = Math.max(0, 10 - rows.length); %>
                    <% for (var r = 0; r < blankRows; r++) { %>
                        <tr class="empty-row"><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% }); %>
    <% if (!company.shareholders || company.shareholders.length === 0) { %>
        <h1>SHARE LEDGER</h1>
        <div class="corp-name"><%= company.name %></div>
        <p style="text-align: center; font-style: italic; margin-top: 40px;">No shareholders recorded.</p>
    <% } %>
</body>

</html>
