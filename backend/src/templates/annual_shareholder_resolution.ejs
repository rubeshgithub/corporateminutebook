<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Annual Shareholder Resolution - <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 40px; line-height: 1.6; font-size: 11pt; color: #1a1a1a; }
        h1 { text-align: center; font-size: 22px; text-decoration: underline; margin-bottom: 4px; }
        h2 { text-align: center; font-size: 18px; margin-top: 8px; }
        .section { margin-top: 24px; }
        .clause { margin-bottom: 16px; text-align: justify; }
        .bold { font-weight: bold; margin-bottom: 6px; }
        .signature { margin-top: 60px; }
        .sig-line { border-top: 1px solid #000; width: 280px; margin-top: 50px; padding-top: 4px; font-size: 10.5pt; }
    </style>
</head>

<body>
    <%
        var res = (typeof resolution !== 'undefined' && resolution) ? resolution : {};
        var resDate = res.resolutionDate ? new Date(res.resolutionDate) : new Date();
        // Stored dates are UTC midnight (date-only) — format in UTC or servers west
        // of UTC print the previous day; "now" fallbacks stay local.
        var resDateOpts = { month: 'long', day: 'numeric', year: 'numeric' };
        if (res.resolutionDate) resDateOpts.timeZone = 'UTC';
        var fiscalYear = res.fiscalYear || new Date().getFullYear();

        // Format fiscal year end: "12-31" → "December 31, 2024"
        var fyParts = (company.fiscalYearEnd || '12-31').split('-');
        var fyDate = new Date(fiscalYear, parseInt(fyParts[0]) - 1, parseInt(fyParts[1]));
        var fyStr = fyDate.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

        var activeDirectors = (res.directors && res.directors.length > 0)
            ? res.directors
            : (company.directors || []).filter(function(d) { return !d.resignedDate; });

        var activeShareholders = (company.shareholders || []).filter(function(s) { return (s.numberOfShares || 0) > 0; });

        var dirName = function(d) {
            return d.name || ([d.firstName, d.middleName, d.lastName].filter(Boolean).join(' ').trim());
        };

        var customItems = res.customResolutions || [];
        var nextNum = 5;
    %>

    <h1>RESOLUTION OF THE SHAREHOLDERS</h1>
    <h2><%= company.name %></h2>
    <p style="text-align: center;">(the "Corporation")</p>

    <div class="section">
        <p>The undersigned, being all the shareholders of the Corporation entitled to vote, hereby consent
            in writing to the following resolutions and certify that these resolutions have been duly passed
            in lieu of the annual meeting of shareholders:</p>
    </div>

    <div class="section">
        <div class="bold">1. ELECTION OF DIRECTORS</div>
        <div class="clause">
            RESOLVED THAT the following persons are elected as directors of the Corporation, to hold office
            until the next annual meeting of shareholders or until their successors are duly elected or appointed:
            <ul>
                <% activeDirectors.forEach(function(d) { %>
                    <li><%= dirName(d) %></li>
                <% }); %>
            </ul>
        </div>
    </div>

    <div class="section">
        <div class="bold">2. WAIVER OF AUDITOR</div>
        <div class="clause">
            RESOLVED THAT, the Corporation being a non-distributing corporation, the appointment of an
            auditor for the ensuing year is hereby waived by unanimous consent of all shareholders entitled
            to vote.
        </div>
    </div>

    <div class="section">
        <div class="bold">3. APPROVAL OF FINANCIAL STATEMENTS</div>
        <div class="clause">
            RESOLVED THAT the financial statements of the Corporation for the fiscal year ending
            <%= fyStr %>, as presented by the directors, are hereby received and approved.
        </div>
    </div>

    <div class="section">
        <div class="bold">4. ACTS OF DIRECTORS AND OFFICERS</div>
        <div class="clause">
            RESOLVED THAT all acts, contracts, by-laws, proceedings, appointments, elections, and payments
            enacted, made, done, and taken by the directors and officers of the Corporation since the date
            of the last annual meeting of shareholders are hereby approved, ratified, and confirmed.
        </div>
    </div>

    <% customItems.forEach(function(cr) { %>
        <% if (cr.title || cr.text) { %>
        <div class="section">
            <div class="bold"><%= nextNum++ %>. <%= (cr.title || '').toUpperCase() %></div>
            <div class="clause"><%= cr.text || '' %></div>
        </div>
        <% } %>
    <% }); %>

    <div class="signature">
        <p>DATED this <%= resDate.toLocaleDateString('en-CA', resDateOpts) %>.</p>
        <% activeShareholders.forEach(function(s) { %>
            <div class="sig-line"><%= s.name %>, Shareholder</div>
        <% }); %>
        <% if (activeShareholders.length === 0) { %>
            <% (company.shareholders || []).forEach(function(s) { %>
                <div class="sig-line"><%= s.name %>, Shareholder</div>
            <% }); %>
        <% } %>
    </div>
</body>

</html>
