<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Share Transfer Register - <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 30px; line-height: 1.4; font-size: 10pt; color: #1a1a1a; }
        h1 { text-align: center; font-size: 18pt; font-weight: 700; margin-bottom: 6px; text-decoration: underline; }
        .corp-name { text-align: center; font-style: italic; margin-bottom: 18px; font-size: 11pt; }
        .lead { font-size: 10.5pt; color: #555; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #555; padding: 6px 6px; text-align: left; font-size: 9.5pt; vertical-align: top; }
        th { background: #f3f3f3; font-weight: bold; }
        .empty-row td { color: #aaa; font-style: italic; text-align: center; height: 26px; }
    </style>
</head>

<body>
    <h1>SHARE TRANSFER REGISTER</h1>
    <div class="corp-name"><%= company.name %></div>
    <p class="lead">Chronological record of every issuance and transfer of shares of the Corporation.</p>

    <%
        var shareEvents = (events || []).filter(function(e) {
            return e.eventType === 'shares_issued' || e.eventType === 'shares_transferred' || e.eventType === 'shares_cancelled';
        });
        var fmtDate = function(d) { return d ? new Date(d).toLocaleDateString() : ''; };

        // Build register rows — prefer event history; fall back to snapshot issuances
        var rows = [];
        if (shareEvents.length > 0) {
            shareEvents.forEach(function(e) {
                var d = e.data || {};
                if (e.eventType === 'shares_issued') {
                    rows.push({
                        date: fmtDate(e.effectiveDate),
                        sharesClass: d.sharesClass || '',
                        certSurrendered: '—',
                        transferor: 'Treasury',
                        transferee: d.name || '',
                        address: d.address || '',
                        certIssued: (d.certificateNumber ? 'A' + d.certificateNumber : '') + ' / ' + (d.numberOfShares || 0),
                    });
                } else if (e.eventType === 'shares_transferred') {
                    rows.push({
                        date: fmtDate(e.effectiveDate),
                        sharesClass: d.sharesClass || '',
                        certSurrendered: d.certificateNumberSurrendered ? ('A' + d.certificateNumberSurrendered + ' / ' + d.numberOfShares) : ('— / ' + (d.numberOfShares || 0)),
                        transferor: d.fromName || '',
                        transferee: d.toName || '',
                        address: d.toAddress || '',
                        certIssued: d.certificateNumberIssued ? ('A' + d.certificateNumberIssued + ' / ' + d.numberOfShares) : ('— / ' + (d.numberOfShares || 0)),
                    });
                } else if (e.eventType === 'shares_cancelled') {
                    rows.push({
                        date: fmtDate(e.effectiveDate),
                        sharesClass: d.sharesClass || '',
                        certSurrendered: d.certificateNumber ? ('A' + d.certificateNumber + ' / ' + d.numberOfShares) : '—',
                        transferor: d.holderName || '',
                        transferee: 'Cancelled',
                        address: '',
                        certIssued: '—',
                    });
                }
            });
        } else {
            // Fallback: initial issuances from company snapshot
            (company.shareholders || []).forEach(function(s, idx) {
                rows.push({
                    date: fmtDate(s.issuanceDate || company.incorporationDate),
                    sharesClass: s.sharesClass,
                    certSurrendered: '—',
                    transferor: 'Treasury',
                    transferee: s.name,
                    address: [s.address, s.city, s.province, s.postalCode, s.country].filter(Boolean).join(', '),
                    certIssued: (s.certificateNumber ? 'A' + s.certificateNumber : 'A' + (idx + 1)) + ' / ' + s.numberOfShares,
                });
            });
        }
    %>

    <table>
        <thead>
            <tr>
                <th>No.</th>
                <th>Date</th>
                <th>Class</th>
                <th>Cert. Surrendered<br/>(No. / Shares)</th>
                <th>Transferor</th>
                <th>Transferee</th>
                <th>Address</th>
                <th>Cert. Issued<br/>(No. / Shares)</th>
                <th>Signature of<br/>Transferor</th>
            </tr>
        </thead>
        <tbody>
            <% rows.forEach(function(row, idx) { %>
                <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= row.date %></td>
                    <td><%= row.sharesClass %></td>
                    <td><%= row.certSurrendered %></td>
                    <td><%= row.transferor %></td>
                    <td><%= row.transferee %></td>
                    <td><%= row.address %></td>
                    <td><%= row.certIssued %></td>
                    <td>&nbsp;</td>
                </tr>
            <% }); %>
            <% var blankRows = Math.max(0, 10 - rows.length); %>
            <% for (var r = 0; r < blankRows; r++) { %>
                <tr class="empty-row"><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
            <% } %>
        </tbody>
    </table>
</body>

</html>
