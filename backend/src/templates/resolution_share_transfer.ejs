<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Board Resolution — <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 44px; line-height: 1.65; font-size: 11pt; color: #1a1a1a; }
        .company-name { text-align: center; font-size: 21px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 2px; }
        .res-type { text-align: center; font-size: 15px; font-weight: bold; margin: 3px 0; }
        .res-sub { text-align: center; font-size: 13px; color: #444; margin: 2px 0 6px 0; }
        .eff-date { text-align: center; font-size: 12px; color: #555; margin-bottom: 20px; }
        hr { border: none; border-top: 1.5px solid #333; margin: 18px 0; }
        table { width: 100%; border-collapse: collapse; margin: 14px 0 20px 0; font-size: 10.5pt; }
        th { background: #2c3e50; color: #fff; padding: 8px 10px; text-align: left; font-size: 10pt; font-weight: 600; }
        td { padding: 7px 10px; border: 1px solid #ccc; vertical-align: top; }
        tr:nth-child(even) td { background: #f7f7f7; }
        .section { margin: 18px 0; }
        .resolved { font-weight: bold; text-transform: uppercase; font-size: 10.5pt; margin-bottom: 6px; }
        .date-line { margin-top: 44px; font-size: 11pt; }
        .sig-section { margin-top: 36px; }
        .sig-grid { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 10px; }
        .sig-block { flex: 1; min-width: 160px; }
        .sig-line { border-top: 1px solid #000; margin-top: 52px; padding-top: 5px; font-size: 10pt; line-height: 1.5; }
    </style>
</head>
<body>
<%
    var ev = (typeof event !== 'undefined' && event) ? event : {};
    var d = ev.data || {};
    var effDate = ev.effectiveDate ? new Date(ev.effectiveDate) : new Date();
    // Stored dates are UTC midnight (date-only) — format in UTC or servers west
    // of UTC print the previous day; the "now" fallback stays local.
    var effDateOpts = { month: 'long', day: 'numeric', year: 'numeric' };
    if (ev.effectiveDate) effDateOpts.timeZone = 'UTC';
    var effDateStr = effDate.toLocaleDateString('en-CA', effDateOpts);

    var activeDirectors = (company.directors || []).filter(function(dir) { return !dir.resignedDate; });
    var dirName = function(dir) {
        return dir.name || ([dir.firstName, dir.middleName, dir.lastName].filter(Boolean).join(' ').trim()) || '';
    };

    // Find the seller shareholder info from snapshot
    var sellerHolder = (company.shareholders || []).find(function(s) {
        return s.name === d.fromName && s.sharesClass === d.sharesClass;
    }) || {};

    var consideration = d.consideration ? '$' + Number(d.consideration).toLocaleString('en-CA', { minimumFractionDigits: 2 }) : 'Nil';
    var sharesDisplay = (d.numberOfShares || 0).toLocaleString('en-CA');

    // Voting percent — use the seller's current votingPercent or compute
    var votePct = sellerHolder.votingPercent ? sellerHolder.votingPercent + '%' : '';

    // Certificate info
    var certSurrendered = d.certificateNumberSurrendered ? 'A' + d.certificateNumberSurrendered : '—';
    var certIssued = d.certificateNumberIssued ? 'A' + d.certificateNumberIssued : '(auto-assigned)';
%>

<div class="company-name"><%= company.name %></div>
<div class="res-type">Board Resolution</div>
<div class="res-sub">Transfer of Shares</div>
<div class="eff-date">Effective <%= effDateStr %></div>

<hr>

<div class="section">
    <p>The following resolution has been duly approved and enacted by the Shareholders and Directors of
    <strong><%= company.name %></strong> (the "Corporation") effective <%= effDateStr %>:</p>
</div>

<div class="section">
    <div class="resolved">Sale of Shares:</div>
    <table>
        <thead>
            <tr>
                <th>Effective Date of Sale</th>
                <th>Selling Shareholder</th>
                <th>Shares — Class</th>
                <% if (votePct) { %><th>Voting %</th><% } %>
                <th>Sale Price</th>
                <th>Sold To</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= effDateStr %></td>
                <td><%= d.fromName || '' %></td>
                <td><%= sharesDisplay %> — <%= d.sharesClass || '' %></td>
                <% if (votePct) { %><td><%= votePct %></td><% } %>
                <td><%= consideration %></td>
                <td><%= d.toName || '' %><% if (d.toAddress) { %><br><small style="color:#555"><%= d.toAddress %></small><% } %></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section">
    <div class="resolved">Changes to Share Register:</div>

    <p style="font-size:10.5pt; margin-bottom: 6px;"><strong>Redeemed / Surrendered:</strong></p>
    <table>
        <thead>
            <tr>
                <th>Certificate #</th>
                <th>Shares</th>
                <th>Class</th>
                <th>Holder (Transferring)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= certSurrendered %></td>
                <td><%= sharesDisplay %></td>
                <td><%= d.sharesClass || '' %></td>
                <td><%= d.fromName || '' %></td>
            </tr>
        </tbody>
    </table>

    <p style="font-size:10.5pt; margin-bottom: 6px; margin-top: 14px;"><strong>Issued (New Certificate):</strong></p>
    <table>
        <thead>
            <tr>
                <th>Certificate #</th>
                <th>Shares</th>
                <th>Class</th>
                <th>Holder (Receiving)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= certIssued %></td>
                <td><%= sharesDisplay %></td>
                <td><%= d.sharesClass || '' %></td>
                <td><%= d.toName || '' %></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section">
    <div class="resolved">It is further resolved that:</div>
    <p>Any changes to the Share Register will have to be approved and signed by the Shareholders and
    Directors of the Corporation. Any officer or director of the Corporation is hereby authorized to
    execute and deliver all such documents and to do all such acts and things as may be necessary or
    desirable to give full force and effect to the foregoing resolutions.</p>
</div>

<div class="section">
    <p>Acknowledgement that the transfer of shares took place as described above and that the parties
    consent to the amendment of the Corporation's share register accordingly.</p>
</div>

<% if (ev.notes) { %>
<div class="section">
    <p><strong>Notes:</strong> <%= ev.notes %></p>
</div>
<% } %>

<div class="date-line">DATE: ___________________________________</div>

<div class="sig-section">
    <div class="resolved">Signed:</div>
    <div class="sig-grid">
        <% activeDirectors.forEach(function(dir) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= company.name %></strong><br>
                <%= dirName(dir) %><br>
                Director
            </div>
        </div>
        <% }); %>
        <% if (d.fromName) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= company.name %></strong><br>
                <%= d.fromName %><br>
                Shareholder (Transferring)
            </div>
        </div>
        <% } %>
        <% if (d.toName) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= company.name %></strong><br>
                <%= d.toName %><br>
                Shareholder (Receiving)
            </div>
        </div>
        <% } %>
    </div>
</div>

</body>
</html>
