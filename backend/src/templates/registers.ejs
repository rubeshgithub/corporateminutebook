<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Corporate Registers - <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 0; line-height: 1.55; font-size: 11pt; }
        h1 { text-align: center; font-size: 22px; text-decoration: underline; margin-bottom: 6px; }
        h2 { text-align: center; font-size: 15px; margin-top: 4px; margin-bottom: 24px; color: #333; }
        .register-title { font-size: 16pt; font-weight: bold; margin-top: 24px; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 2px solid #1a237e; color: #1a237e; }
        .register-subtitle { font-style: italic; color: #555; margin-bottom: 12px; font-size: 10.5pt; }
        table { border-collapse: collapse; width: 100%; margin-top: 4px; }
        th, td { border: 1px solid #555; padding: 6px 8px; text-align: left; font-size: 10.5pt; vertical-align: top; }
        th { background: #f3f3f3; font-weight: bold; }
        .empty { text-align: center; font-style: italic; color: #888; padding: 18px; }
        .page-break { page-break-after: always; }
    </style>
</head>

<body>
    <h1>CORPORATE REGISTERS</h1>
    <h2><%= company.name %></h2>

    <div class="register-title">A. Register of Directors</div>
    <div class="register-subtitle">Required pursuant to the applicable corporate legislation.</div>
    <% if (company.directors && company.directors.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Residential Address</th>
                    <th>Date Appointed</th>
                    <th>Date Resigned</th>
                </tr>
            </thead>
            <tbody>
                <% company.directors.forEach(function(d) { %>
                    <tr>
                        <td><%= d.name %></td>
                        <td><%= [d.address, d.city, d.province, d.postalCode, d.country].filter(Boolean).join(', ') %></td>
                        <td><%= d.appointedDate ? new Date(d.appointedDate).toLocaleDateString() : '' %></td>
                        <td><%= d.resignedDate ? new Date(d.resignedDate).toLocaleDateString() : '—' %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty">No directors recorded.</div>
    <% } %>

    <div class="register-title">B. Register of Officers</div>
    <div class="register-subtitle">Officers appointed by the Board of Directors.</div>
    <% if (company.officers && company.officers.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Office Held</th>
                    <th>Date Appointed</th>
                    <th>Date Resigned</th>
                </tr>
            </thead>
            <tbody>
                <% company.officers.forEach(function(o) { %>
                    <tr>
                        <td><%= o.name %></td>
                        <td><%= o.title %></td>
                        <td><%= o.appointedDate ? new Date(o.appointedDate).toLocaleDateString() : '' %></td>
                        <td><%= o.resignedDate ? new Date(o.resignedDate).toLocaleDateString() : '—' %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty">No officers recorded.</div>
    <% } %>

    <div class="register-title">C. Securities Register / Shareholders' Ledger</div>
    <div class="register-subtitle">Record of issued and outstanding shares of the Corporation.</div>
    <% if (company.shareholders && company.shareholders.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Holder</th>
                    <th>Class of Shares</th>
                    <th>Number of Shares</th>
                    <th>Certificate No.</th>
                    <th>Date of Issue</th>
                </tr>
            </thead>
            <tbody>
                <% company.shareholders.forEach(function(s, idx) { %>
                    <tr>
                        <td><%= s.name %></td>
                        <td><%= s.sharesClass %></td>
                        <td><%= s.numberOfShares %></td>
                        <td><%= idx + 1 %></td>
                        <td><%= company.incorporationDate ? new Date(company.incorporationDate).toLocaleDateString() : '' %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
        <%
            var byClass = {};
            company.shareholders.forEach(function(s){
                byClass[s.sharesClass] = (byClass[s.sharesClass] || 0) + (s.numberOfShares || 0);
            });
        %>
        <div style="margin-top: 18px; font-weight: bold;">Summary of Issued and Outstanding Shares</div>
        <table style="margin-top: 4px; width: 50%;">
            <thead>
                <tr><th>Class</th><th>Total Issued</th></tr>
            </thead>
            <tbody>
                <% Object.keys(byClass).forEach(function(cls){ %>
                    <tr><td><%= cls %></td><td><%= byClass[cls] %></td></tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty">No securities issued.</div>
    <% } %>
</body>

</html>
