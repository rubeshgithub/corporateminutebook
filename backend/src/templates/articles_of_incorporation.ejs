<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Articles of Incorporation - <%= company.name %>
    </title>
    <style>
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            padding: 40px;
        }

        h1 {
            text-align: center;
            font-size: 24px;
            text-decoration: underline;
        }

        .section {
            margin-top: 30px;
        }

        .section-title {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .data-row {
            margin-bottom: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }
    </style>
</head>

<body>
    <h1>ARTICLES OF INCORPORATION</h1>

    <div class="section">
        <div class="section-title">1. Name of Corporation</div>
        <div class="data-row">
            <%= company.name %>
        </div>
    </div>

    <div class="section">
        <div class="section-title">2. Corporate Access Number</div>
        <div class="data-row">
            <%= company.corporateAccessNumber || 'N/A' %>
        </div>
    </div>

    <div class="section">
        <div class="section-title">3. Registered Office</div>
        <div class="data-row">
            <%= company.registeredOfficeAddress.street %>
        </div>
        <div class="data-row">
            <%= company.registeredOfficeAddress.city %>, <%= company.registeredOfficeAddress.province %>
                    <%= company.registeredOfficeAddress.postalCode %>
        </div>
        <div class="data-row">
            <%= company.registeredOfficeAddress.country %>
        </div>
    </div>

    <div class="section">
        <div class="section-title">4. Directors</div>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Appointed Date</th>
                </tr>
            </thead>
            <tbody>
                <% company.directors.forEach(function(director) { %>
                    <tr>
                        <td>
                            <%= director.name %>
                        </td>
                        <td>
                            <%= director.address %>
                        </td>
                        <td>
                            <%= new Date(director.appointedDate).toLocaleDateString() %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>

    <div class="section">
        <div class="section-title">5. Share Structure</div>
        <table>
            <thead>
                <tr>
                    <th>Shareholder Name</th>
                    <th>Class of Shares</th>
                    <th>Number of Shares</th>
                </tr>
            </thead>
            <tbody>
                <% company.shareholders.forEach(function(shareholder) { %>
                    <tr>
                        <td>
                            <%= shareholder.name %>
                        </td>
                        <td>
                            <%= shareholder.sharesClass %>
                        </td>
                        <td>
                            <%= shareholder.numberOfShares %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>

    <div style="margin-top: 80px;">
        <p>Dated: <%= new Date().toLocaleDateString() %>
        </p>
        <p>_____________________________________</p>
        <p>Authorized Signature</p>
    </div>
</body>

</html>