<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Board Resolution — <%= company.name %></title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; padding: 44px; line-height: 1.65; font-size: 11pt; color: #1a1a1a; }
        .company-name { text-align: center; font-size: 21px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 2px; }
        .res-type { text-align: center; font-size: 15px; font-weight: bold; margin: 3px 0; }
        .res-sub { text-align: center; font-size: 13px; color: #444; margin: 2px 0 6px 0; }
        .eff-date { text-align: center; font-size: 12px; color: #555; margin-bottom: 20px; }
        hr { border: none; border-top: 1.5px solid #333; margin: 18px 0; }
        table { width: 100%; border-collapse: collapse; margin: 14px 0 20px 0; font-size: 10.5pt; }
        th { background: #2c3e50; color: #fff; padding: 8px 10px; text-align: left; font-size: 10pt; font-weight: 600; }
        td { padding: 7px 10px; border: 1px solid #ccc; vertical-align: top; }
        tr:nth-child(even) td { background: #f7f7f7; }
        .section { margin: 18px 0; }
        .resolved { font-weight: bold; text-transform: uppercase; font-size: 10.5pt; margin-bottom: 6px; }
        .date-line { margin-top: 44px; font-size: 11pt; }
        .sig-section { margin-top: 36px; }
        .sig-grid { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 10px; }
        .sig-block { flex: 1; min-width: 160px; }
        .sig-line { border-top: 1px solid #000; margin-top: 52px; padding-top: 5px; font-size: 10pt; line-height: 1.5; }
    </style>
</head>
<body>
<%
    var ev = (typeof event !== 'undefined' && event) ? event : {};
    var d = ev.data || {};
    var effDate = ev.effectiveDate ? new Date(ev.effectiveDate) : new Date();
    var effDateStr = effDate.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

    var activeDirectors = (company.directors || []).filter(function(dir) { return !dir.resignedDate; });
    var dirName = function(dir) {
        return dir.name || ([dir.firstName, dir.middleName, dir.lastName].filter(Boolean).join(' ').trim()) || '';
    };

    var isNameChange = (ev.eventType === 'name_changed');
    var isFYChange = (ev.eventType === 'fiscal_year_end_changed');

    var resolvedTitle = isNameChange ? 'Change of Corporate Name' : 'Change of Fiscal Year End';

    // For fiscal year end — format old and new
    var oldFY = company.fiscalYearEnd || '12-31';
    var newFY = d.newFiscalYearEnd || '';
    var fyFormat = function(fy) {
        if (!fy) return '—';
        var parts = fy.split('-');
        if (parts.length < 2) return fy;
        var dt = new Date(2000, parseInt(parts[0]) - 1, parseInt(parts[1]));
        return dt.toLocaleDateString('en-CA', { month: 'long', day: 'numeric' });
    };
%>

<div class="company-name"><%= isNameChange ? (d.previousName || company.name) : company.name %></div>
<div class="res-type">Board Resolution</div>
<div class="res-sub"><%= resolvedTitle %></div>
<div class="eff-date">Effective <%= effDateStr %></div>

<hr>

<div class="section">
    <p>The following resolution has been duly approved and enacted by the Directors of
    <strong><%= isNameChange ? (d.previousName || company.name) : company.name %></strong>
    (the "Corporation") effective <%= effDateStr %>:</p>
</div>

<% if (isNameChange) { %>
<div class="section">
    <div class="resolved">Change of Corporate Name:</div>
    <table>
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Previous Name</th>
                <th>New Name</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= effDateStr %></td>
                <td><%= d.previousName || company.name %></td>
                <td><%= d.newName || '' %></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section">
    <div class="resolved">It is hereby resolved that:</div>
    <p>The name of the Corporation is hereby changed from
    <strong>"<%= d.previousName || company.name %>"</strong> to
    <strong>"<%= d.newName || '' %>"</strong>, effective <%= effDateStr %>,
    subject to approval by the applicable corporate registry.</p>
</div>
<% } %>

<% if (isFYChange) { %>
<div class="section">
    <div class="resolved">Change of Fiscal Year End:</div>
    <table>
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Previous Fiscal Year End</th>
                <th>New Fiscal Year End</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= effDateStr %></td>
                <td><%= fyFormat(oldFY) %></td>
                <td><%= fyFormat(newFY) %></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section">
    <div class="resolved">It is hereby resolved that:</div>
    <p>The fiscal year end of the Corporation is hereby changed from
    <strong><%= fyFormat(oldFY) %></strong> to <strong><%= fyFormat(newFY) %></strong>,
    effective for the fiscal year ending <%= effDateStr %>.</p>
</div>
<% } %>

<div class="section">
    <div class="resolved">It is further resolved that:</div>
    <p>Any officer or director of the Corporation is hereby authorized to execute and deliver all such
    documents and to do all such acts and things as may be necessary or desirable to give full force
    and effect to the foregoing resolutions, including filing any required notice with the applicable
    corporate registry and updating all corporate records accordingly.</p>
</div>

<% if (ev.notes) { %>
<div class="section">
    <p><strong>Notes:</strong> <%= ev.notes %></p>
</div>
<% } %>

<div class="date-line">DATE: ___________________________________</div>

<div class="sig-section">
    <div class="resolved">Signed:</div>
    <div class="sig-grid">
        <% activeDirectors.forEach(function(dir) { %>
        <div class="sig-block">
            <div class="sig-line">
                <strong><%= isNameChange ? (d.newName || company.name) : company.name %></strong><br>
                <%= dirName(dir) %><br>
                Director
            </div>
        </div>
        <% }); %>
    </div>
</div>

</body>
</html>
