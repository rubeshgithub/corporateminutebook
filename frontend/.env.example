# MinuteBook SPA — environment template.
# Copy to `.env` and fill in. Never commit the filled-in file.
#
# Vite inlines every VITE_* var into the built JavaScript bundle. Treat all of
# them as PUBLIC — anyone can read them from the shipped app. Never put a
# secret here; restrict keys at the provider instead.

# Base URL of the API. No trailing slash.
VITE_API_URL=http://localhost:5000

# Google Places (New) key for address autocomplete.
# Because this ships in the bundle, it MUST be restricted in Google Cloud
# Console: HTTP-referrer restriction to your domains + API restriction to
# Places API only. An unrestricted key can be lifted from the bundle and
# billed against your account.
# Leave blank to disable autocomplete — address fields degrade to plain text.
# NOTE: set this in your production host's build environment too, or the
# deployed app silently loses autofill.
VITE_GOOGLE_PLACES_API_KEY=
